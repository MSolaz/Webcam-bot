# Token del bot, obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# IDs de Telegram con permiso para usar el bot, separados por comas.
# Averigua el tuyo hablando con @userinfobot
ALLOWED_USER_IDS=

# Dispositivo de la webcam dentro del contenedor (normalmente no hace falta tocarlo)
CAMERA_DEVICE=/dev/video0

# Resolución de captura solicitada a la webcam
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Fotogramas descartados al abrir la cámara antes de capturar el definitivo
# (evita fotos oscuras/verdosas por exposición sin ajustar)
WARMUP_FRAMES=10

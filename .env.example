# Token del bot, obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# IDs de Telegram con permiso para usar el bot, separados por comas.
# Averigua el tuyo hablando con @userinfobot
ALLOWED_USER_IDS=

# Dispositivo de la webcam dentro del contenedor (normalmente no hace falta tocarlo)
CAMERA_DEVICE=/dev/video0

# Resolución de captura solicitada a la webcam
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Fotogramas descartados al abrir la cámara antes de capturar el definitivo
# (evita fotos oscuras/verdosas por exposición sin ajustar)
WARMUP_FRAMES=10

# --- Vigilancia automática de perro ---
# Requiere los archivos del modelo en models/ (ver README). Si no están,
# el bot funciona igual pero sin esta función.

# Si la vigilancia empieza activada o desactivada al arrancar el bot
# (siempre se puede cambiar luego con el botón "🐶 Vigilancia" o /vigilancia)
DOG_WATCHDOG_ENABLED=true

# Cada cuántos segundos revisa la cámara en busca de un perro
DOG_CHECK_INTERVAL_SECONDS=5

# Tiempo mínimo entre dos avisos de Telegram (evita spam mientras el
# perro sigue delante de la cámara)
DOG_ALERT_COOLDOWN_SECONDS=60

# Confianza mínima (0-1) para considerar que hay un perro. Súbelo si
# recibes falsos positivos, bájalo si no detecta al perro real.
DOG_MIN_CONFIDENCE=0.4

# Fotogramas de calentamiento para la comprobación periódica (menos que
# WARMUP_FRAMES porque se repite muy a menudo)
DOG_CHECK_WARMUP_FRAMES=3

# --- Reset USB de la cámara ---
# Segundos de espera tras el reset antes de comprobar que la cámara
# volvió a responder
RESET_SETTLE_SECONDS=5

# --- Anti-ladridos (micrófono + altavoz) ---
# Requiere models/ladridos.tflite y models/ladridos_info.json (se generan con
# notebooks/entrenar_ladridos.ipynb) y el detector de perro. Si faltan, el bot
# funciona igual pero sin esta función.

# Si el anti-ladridos empieza activado o desactivado al arrancar el bot
# (siempre se puede cambiar luego con el botón "🔊 Anti-ladridos" o /ladridos)
BARK_GUARD_ENABLED=true

# Dispositivos ALSA del micrófono y del altavoz. Consulta los nombres en el
# servidor con `arecord -L` y `aplay -L` (ver README). Usa los que empiezan
# por plughw: para que ALSA convierta el formato automáticamente.
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default

# Audio que se reproduce (WAV) cuando ladra y la cámara ve al perro
BARK_SOUND_FILE=/app/sounds/ladrido.wav

# Probabilidad mínima (0-1) para considerar que es un ladrido. Vacío = usar
# el umbral_recomendado de ladridos_info.json
BARK_THRESHOLD=

# Tiempo mínimo entre dos actuaciones (audio + aviso de Telegram)
BARK_ALERT_COOLDOWN_SECONDS=60

# Fotos que hace (una por segundo) buscando al perro tras oír un ladrido
BARK_CAMERA_CHECKS=3
